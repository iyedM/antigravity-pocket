# Mot de passe requis pour se connecter depuis l'application mobile (FORTEMENT RECOMMANDÉ)
APP_PASSWORD=ChangeMeWithAStrongPassword2026!

# Clé secrète HMAC-SHA256 (64 caractères hex) pour signer les jetons de session
APP_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Dossier du workspace isolé accessible par l'agent et le File Manager
AGY_WORKSPACE=./workspace

# Chemin de la base SQLite persistante (sessions + timeline d'événements)
AGY_DB_PATH=./data/antigravity_pocket.db

# Mode de permission par défaut : read_only | assisted | autonomous
AGY_DEFAULT_PERMISSION_MODE=assisted

# Taille maximale d'upload par fichier (en Mo)
AGY_MAX_UPLOAD_MB=50

# Durée de validité des jetons signés (en secondes, défaut : 86400 = 24h)
AGY_TOKEN_TTL_SECONDS=86400
