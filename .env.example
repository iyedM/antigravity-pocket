# ============================================================================
# Antigravity Pocket v2.2.0 — Configuration Modèle (.env.example)
# IMPORTANT : Ne réutilisez jamais de secrets d'exemple. Générez vos propres
# valeurs aléatoires avec les commandes ci-dessous avant de démarrer.
# ============================================================================

# 1. Mot de passe fort obligatoire (min. 8 caractères non triviaux)
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(18))"
APP_PASSWORD=<REMPLACER_PAR_UN_MOT_DE_PASSE_ALEATOIRE_FORT>

# 2. Clé secrète HMAC-SHA256 obligatoire (64 caractères hexadécimaux aléatoires)
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=<REMPLACER_PAR_64_CARACTERES_HEX_ALEATOIRES>

# 3. Dossier du workspace isolé accessible par l'agent et le File Manager
AGY_WORKSPACE=./workspace

# 4. Chemin de la base SQLite persistante (sessions, événements, révocations JTI)
AGY_DB_PATH=./data/antigravity_pocket.db

# 5. Mode de permission par défaut : read_only | assisted | autonomous
AGY_DEFAULT_PERMISSION_MODE=assisted

# 6. Quotas de fichiers (en Mo)
AGY_MAX_UPLOAD_MB=50
AGY_MAX_WORKSPACE_MB=500

# 7. Durée de validité des jetons signés (en secondes, défaut : 86400 = 24h)
AGY_TOKEN_TTL_SECONDS=86400
